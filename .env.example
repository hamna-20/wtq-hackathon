# WTQ Utility Bill Decoder - environment configuration
# Copy to .env and fill in your real API keys. Never commit .env.

# Model provider: only "google" is supported in the shipped build.
MODEL_PROVIDER=google

# Model used for all extraction and Q&A calls.
# Allowed models: gemini-3.5-flash-lite, gemini-3.1-flash-lite,
# claude-haiku-4-5, gpt-4.1-mini, gpt-5-mini
MODEL_NAME=gemini-3.5-flash-lite

# Alias kept for backwards compatibility (same as MODEL_PROVIDER=google).
AI_PROVIDER=gemini

# Google AI Studio (Gemini) API keys.
# PRIMARY is required. SECONDARY is optional and used automatically if the
# primary key hits a rate limit or fails.
GEMINI_API_KEY_PRIMARY=your-gemini-api-key-here
GEMINI_API_KEY_SECONDARY=

# Optional. The app ships without a database; the pipeline writes CSV files
# directly. Set this only if you add database-backed features.
DATABASE_URL=postgresql://user:password@localhost:5432/wtq